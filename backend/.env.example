# Database — defaults already match docker-compose.yml, only needed if you
# change ports/credentials.
SERVICE_DATABASE_URL=postgres://recovery_service:recovery_service@localhost:5432/revenue_recovery
APP_DATABASE_URL=postgres://recovery_app:recovery_app@localhost:5432/revenue_recovery
MIGRATE_DATABASE_URL=postgres://recovery:recovery@localhost:5432/revenue_recovery

PORT=4000

# Deployed backend only: comma-separated browser origins allowed to call
# the API, e.g. https://your-app.vercel.app. Leave empty for local dev.
CORS_ORIGINS=

# All optional. Unset = the corresponding adapter runs in deterministic
# mock mode (see src/adapters/*.ts) so the full pipeline is runnable with
# zero external accounts.
ANTHROPIC_API_KEY=
SARVAM_API_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
