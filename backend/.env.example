# Database — defaults already match docker-compose.yml, only needed if you
# change ports/credentials.
SERVICE_DATABASE_URL=postgres://recovery_service:recovery_service@localhost:5432/revenue_recovery
APP_DATABASE_URL=postgres://recovery_app:recovery_app@localhost:5432/revenue_recovery
MIGRATE_DATABASE_URL=postgres://recovery:recovery@localhost:5432/revenue_recovery

PORT=4000

# Deployed backend only: comma-separated browser origins allowed to call
# the API, e.g. https://your-app.vercel.app. Leave empty for local dev.
CORS_ORIGINS=

# Set to "production" on a deployed host. Makes auth fail CLOSED: the
# synthetic ingest path and /internal/sweep refuse requests when no
# INGEST_API_KEY is configured, instead of running open.
NODE_ENV=

# Shared secret for POST /webhooks/synthetic and POST /internal/sweep.
# REQUIRED in production — both write to the database and spend money on
# model calls, so neither may be openly callable. Generate with:
#   openssl rand -hex 32
INGEST_API_KEY=

# Webhook requests allowed per IP per minute (0 disables). Every accepted
# webhook runs the full pipeline including a paid LLM call.
WEBHOOK_RATE_LIMIT_PER_MIN=120

# All optional. Unset = the corresponding adapter runs in deterministic
# mock mode (see src/adapters/*.ts) so the full pipeline is runnable with
# zero external accounts.
OPENAI_API_KEY=
# Optional override — defaults to gpt-5.5 if unset.
OPENAI_MODEL=
SARVAM_API_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
